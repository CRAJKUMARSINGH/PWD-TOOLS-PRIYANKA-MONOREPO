{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const agent=process.env.npm_config_user_agent||''; if(!agent.startsWith('pnpm/')){process.stderr.write('Use pnpm instead\\n');process.exit(1);}\"",
    "dev": "pnpm --filter @workspace/pwd-tools dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "vitest"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "date-fns": "^3.6.0",
    "lightningcss": "1.30.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.62.2",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
